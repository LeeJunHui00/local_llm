# 사내 LLM 접속 환경변수 템플릿
#   cp setup/env.sh.example ~/.llm-env
#   편집 후  source ~/.llm-env
#
# 주의: 토큰을 저장소에 커밋하지 말 것. 홈 디렉터리에 두고 chmod 600 권장.

# ---------------------------------------------------------------------------
# 1. 게이트웨이 규격에 따라 아래 둘 중 하나를 사용함
#    (capability-check.py 로 어느 쪽인지 먼저 확인할 것)
# ---------------------------------------------------------------------------

# [A] Anthropic 호환 게이트웨이인 경우
#     Claude Code 계열 CLI 에이전트가 별도 프록시 없이 그대로 붙음. 가장 편한 경우임.
# export ANTHROPIC_BASE_URL="https://llm.example.internal"
# export ANTHROPIC_AUTH_TOKEN="여기에_사내_발급_토큰"
# export ANTHROPIC_MODEL="<모델ID>"              # 주 모델. 실제 ID 는 capability-check.py 로 확인
# export ANTHROPIC_SMALL_FAST_MODEL="<경량모델ID>" # 요약/보조용. 없으면 생략 가능

# [B] OpenAI 호환 게이트웨이인 경우
export OPENAI_BASE_URL="https://llm.example.internal/v1"
export OPENAI_API_KEY="여기에_사내_발급_토큰"
export LLM_MODEL="<모델ID>"                     # 실제 ID 는 capability-check.py 로 확인

# CLI 에이전트가 Anthropic 규격만 받는데 게이트웨이가 OpenAI 호환뿐이라면
# 변환 프록시를 로컬에 한 겹 띄워야 함. 폐쇄망이므로 wheel 사전 반입 필요:
#   uv pip download litellm -d ./wheels   (인터넷 되는 PC에서 받아 반입)
#   litellm --model openai/$LLM_MODEL --api_base $OPENAI_BASE_URL --port 4000
#   export ANTHROPIC_BASE_URL="http://127.0.0.1:4000"

# ---------------------------------------------------------------------------
# 2. 폐쇄망에서 실제로 가장 많이 막히는 지점 - 프록시와 사설 CA
# ---------------------------------------------------------------------------

# 사내 프록시를 거쳐야 하는 경우
# export HTTP_PROXY="http://proxy.example.internal:8080"
# export HTTPS_PROXY="$HTTP_PROXY"
# LLM 게이트웨이는 프록시를 거치면 안 되는 경우가 많으므로 NO_PROXY 에 반드시 포함
export NO_PROXY="localhost,127.0.0.1,.example.internal"

# 사내 사설 CA 로 TLS 를 종단하는 경우 (인증서 검증 실패의 주범)
# export SSL_CERT_FILE="/etc/ssl/certs/corp-ca.pem"       # python/openssl
# export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"              # python requests
# export NODE_EXTRA_CA_CERTS="$SSL_CERT_FILE"             # node 기반 CLI 에이전트
# export CURL_CA_BUNDLE="$SSL_CERT_FILE"                  # curl
#
# 검증 우회는 임시 확인용으로만. 상시 사용 금지.
# export LLM_INSECURE_SSL=1

# ---------------------------------------------------------------------------
# 3. MCP 서버 설정 (mcp/ 아래 서버들이 읽음)
# ---------------------------------------------------------------------------

export LLM_REPO_ROOT="$HOME/work/myproject"     # 분석 대상 저장소
export LLM_REPO_DENY=""                          # 차단 경로 패턴, 콜론 구분
export LLM_TAGS_FILE="$LLM_REPO_ROOT/tags"

export LLM_BUILD_DIR="$LLM_REPO_ROOT/build"
export LLM_BUILD_CMD="cmake --build . -j"
export LLM_BUILD_TIMEOUT=1800

export LLM_GDB="gdb"                             # 크로스 툴체인이면 arm-none-eabi-gdb 등
export LLM_GDB_TIMEOUT=60
# export LLM_GDB_SYSROOT="/opt/target-sysroot"
# export LLM_GDB_SOLIB_PATH="$LLM_REPO_ROOT/build/lib"

# 모델 컨텍스트가 좁으면 이 값을 줄여 도구 출력을 더 강하게 자름
export LLM_MCP_MAX_OUTPUT=20000
